# Leave SERPAPI_KEY empty for mock/example data on the box.
SERPAPI_KEY=

# Upstash Redis (required on Vercel). Leave both empty locally to use data/store.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GoHighLevel inbound webhook — paste the workflow webhook URL. Leave empty to skip.
GHL_WEBHOOK_URL=

NEXT_PUBLIC_BOOKING_URL=https://weareoffcut.com/#book
MONTHLY_CAP=400
DAILY_CAP_PER_USER=3
FRAME_ANCESTORS="'self' https://weareoffcut.com https://*.weareoffcut.com"

# Optional: override local JSON path (ignored when Upstash is configured)
# STORE_FILE=
